# Copy to .env (ignored by git). Values are never printed by the scripts.
# Key-pair authentication: the private key stays on this machine, Snowflake holds only the public key.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_ROLE=MOTHERLODE_PIPELINE
SNOWFLAKE_WAREHOUSE=MOTHERLODE_XS
SNOWFLAKE_DATABASE=MOTHERLODE

# Spending cap in US dollars of trial balance. The pipeline refuses to start a step that would pass it.
SPEND_CAP_USD=150
# Models. Check SHOW CORTEX BASE MODELS IN SCHEMA SNOWFLAKE.MODELS for what the account can call.
EXTRACT_MODEL=claude-sonnet-5
AGENT_MODEL=auto
MAX_EXTRACT_ATTEMPTS=2
